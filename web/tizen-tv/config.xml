<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/Liandersson/Painho_Lula/tizen-tv"
        version="1.4.0"
        viewmodes="maximized">
  <tizen:application id="painholula.PainhoLulaTV" package="painholula" required_version="9.0" />
  <tizen:profile name="tv-samsung" />
  <feature name="http://tizen.org/feature/screen.size.normal" />
  <access origin="*" subdomains="true" />
  <content src="full-app/index.html" />
  <icon src="icon.png" />
  <name>LqMusic</name>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read" />
  <tizen:privilege name="http://tizen.org/privilege/externalstorage" />
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />
</widget>
